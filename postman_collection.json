{
  "info": {
    "name": "Users, Projects & Tasks API",
    "description": "Collection covering all endpoints of the Users, Projects & Tasks REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "userId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajasekhar\",\n  \"email\": \"raja@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"member\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        { "name": "List Users", "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=20" } },
        { "name": "Get User by ID", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rajasekhar G\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DevPulse\",\n  \"description\": \"Developer productivity dashboard\",\n  \"owner\": \"{{userId}}\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/projects"
          }
        },
        { "name": "List Projects", "request": { "method": "GET", "url": "{{baseUrl}}/projects?status=active&page=1&limit=20" } },
        { "name": "Get Project by ID", "request": { "method": "GET", "url": "{{baseUrl}}/projects/{{projectId}}" } },
        {
          "name": "Update Project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"archived\"\n}" },
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        },
        { "name": "Delete Project", "request": { "method": "DELETE", "url": "{{baseUrl}}/projects/{{projectId}}" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build metrics API\",\n  \"description\": \"Serverless analytics endpoint\",\n  \"project\": \"{{projectId}}\",\n  \"assignee\": \"{{userId}}\",\n  \"status\": \"todo\",\n  \"dueDate\": \"2026-09-20\"\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        { "name": "List Tasks", "request": { "method": "GET", "url": "{{baseUrl}}/tasks?project={{projectId}}&status=todo&page=1&limit=20" } },
        { "name": "Get Task by ID", "request": { "method": "GET", "url": "{{baseUrl}}/tasks/{{taskId}}" } },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Build metrics API v2\"\n}" },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in-progress\"\n}" },
            "url": "{{baseUrl}}/tasks/{{taskId}}/status"
          }
        },
        { "name": "Delete Task", "request": { "method": "DELETE", "url": "{{baseUrl}}/tasks/{{taskId}}" } }
      ]
    }
  ]
}
